  <header class="page-header">
    <h5 class="align-center">
      <%= image_tag "logo.svg", class: "logo", alt: "ロゴ画像" %>
    </h5>

    <nav>
      <ul class="main-nav font-english">
        <li>
          <select class="form-select form-select-sm border-0 text-left" aria-label="My Account"
            onchange="
            if (this.value === '<%= how_to_use_path %>') {
              document.querySelector('turbo-frame#main_content').src = this.value;
            } else if (this.value) {
              window.location.href = this.value;
            }
            this.selectedIndex = 0;
          ">
            <option value="" selected>ユーザ設定</option>
            <option value="">メールアドレス変更</option>
            <option value="">パスワード変更</option>
            <option value="<%= how_to_use_path %>">使い方説明</option>
          </select>

        <li>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-primary btn-sm" %>
        </li>
      </ul>
    </nav>
  </header>