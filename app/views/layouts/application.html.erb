<!DOCTYPE html>
<html>
  <head>

    <title><%= content_for(:title) || "App" %></title>

    <!-- ブラウザ初期をクリア -->
    <link rel="stylesheet" href="https://unpkg.com/ress/dist/ress.min.css">

    <!-- 未ログインの場合とログイン中の場合で表示する画面のcssを切り替えて使っている -->
    <!--  if current_user      実際はこのように修正必要-->

    <% if logged_in? %>
      <%= stylesheet_link_tag "static_pages", "data-turbo-track": "reload" %>
      <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <% else %>
      <%= stylesheet_link_tag "login_menu", "data-turbo-track": "reload" %>
    <% end %>

    <!-- bootstrapを適用 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

  </head>

  <body style="<%=  logged_in? ? 'margin: 0 !important; padding: 0 !important; display: block !important; height: auto !important;' : 'margin: 0; padding: 0; min-height: 100vh;' %>">

    <% if logged_in? %>

      <div style="display: flow-root; width: 100%; margin: 0 !important; padding: 0 !important;">
        <%= render "layouts/header" %>

        <!-- flash表示追加 2026.6/19 -->
        <% flash.each do |message_type, message| %>
          <div class="alert alert-<%= message_type %>">
            <%= message %>
          </div>
        <% end %>

        <turbo-frame id="main_content">
          <%= yield %>
        </turbo-frame>
  
        <%= render "layouts/footer" %>
      </div>

    <% else %>

      <div style="display: flex; align-items: center; justify-content: center; min-height: 100vh; width: 100%; background-color: #f5f5f5;">

        <turbo-frame id="main_content">

        <!-- flash表示追加 2026.6/19 -->
        <% flash.each do |message_type, message| %>
          <div class="alert alert-<%= message_type %>">
            <%= message %>
          </div>
        <% end %>

          <%= render 'shared/login_menu' %>
        </turbo-frame>
      </div>
    <% end %>

  </body>
</html>