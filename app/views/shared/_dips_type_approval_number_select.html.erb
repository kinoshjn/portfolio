<tr style="text-align: center;">
  <th scope="col">型式認証番号</th>
  <td style="text-align: center;">
    <div style="display: flex; align-items: center;">
      <select id="dips_type_approval_select" class="form-select form-select-sm border border-secondary text-center" aria-label="種類選択">
        <option value="">型式選択</option>
        <option value="1">なし(型式認証なし)</option>
        <option value="2">その他</option>
      </select>
      <div id="dips_type_approval_input_wrapper" style="display: none; width: 100%;">
        <input type="text" id="dips_type_approval_input" class="form-control form-control-sm border border-secondary text-center" placeholder="型式認証番号を入力" style="width: calc(100% - 30px); display: inline-block;">
        <span id="dips_type_approval_reset" style="cursor: pointer; font-size: 12px;">▽</span>
      </div>
    </div>
  </td>
</tr>

<script>
  const selectApproval = document.getElementById('dips_type_approval_select');
  const inputApproval = document.getElementById('dips_type_approval_input');
  const wrapperApproval = document.getElementById('dips_type_approval_input_wrapper');
  const resetApproval = document.getElementById('dips_type_approval_reset');

  selectApproval.addEventListener('change', function() {
    if (this.value === '2') {
      selectApproval.style.display = 'none';
      wrapperApproval.style.display = 'block';
      inputApproval.focus();
    }
  });

  resetApproval.addEventListener('click', function() {
    wrapperApproval.style.display = 'none';
    inputApproval.value = '';
    selectApproval.style.display = 'block';
    selectApproval.value = '';
  });
</script>