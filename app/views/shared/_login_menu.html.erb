<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>ログイン画面</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="stylesheet" href="style2.css">
</head>
<body>

  <main class="form-signin">
    <%= form_with url: login_path, data: { turbo_frame: "_top" } do |f| %>

      <h3 class="h3 mb-3 fw-normal text-center">ログイン</h3>

      <div class="form-floating mb-3">
        <%= f.email_field :email, class: "form-control", placeholder: "name@example.com", id: "floatingInput" %>
        <label for="floatingInput">ユーザ (user@example.com)</label>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password, class: "form-control", placeholder: "Password", id: "floatingPassword" %>
        <label for="floatingPassword">パスワード</label>
      </div>

      <%= f.submit "ログインする", class: "mb-3 w-100 btn btn-lg btn-primary" %>

      <ul class="user-nav">
        <li>
          <%= link_to "ユーザ登録", new_user_path, data: { turbo_frame: "_top" } %>
        </li>
        <li><a href="#">パスワード忘れた方</a></li>
      </ul>
      <p class="text-credit text-center">&copy; 2026 kino project</p>
    <% end %>
  </main>
</body>
</html>