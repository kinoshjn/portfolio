<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>ログイン画面</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="stylesheet" href="style2.css">
</head>
<body>

  <main class="form-signin">
    <form>
      <h3 class="h3 mb-3 fw-normal text-center">ログイン</h3>

      <div class="form-floating mb-3">
        <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com">
        <label for="floatingInput">ユーザ   (user@example.com)</label>
      </div>

      <div class="form-floating mb-3">
        <input type="password" class="form-control" id="floatingPassword" placeholder="Password">
        <label for="floatingPassword">パスワード</label>
      </div>

      <button class="mb-3 w-100 btn btn-lg btn-primary" type="submit">ログインする</button>

      <ul class="user-nav">
        <li>
          <%= link_to "ユーザ登録", new_user_path, data: { turbo_frame: "_top" } %>
        </li>
        <li><a href="#">パスワード忘れた方</a></li>
      </ul>
      <p class="text-credit text-center">&copy; 2026 kino project</p>
    </form>
  </main>
</body>

</html>