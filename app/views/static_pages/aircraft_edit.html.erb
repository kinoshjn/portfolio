<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">機体編集</span></li>
          <li><span class="fs-4" style="margin-right: 20px;">ID: <%= @aircraft.id %></span></li>
          <li>
            <button type="submit" form="aircraft_edit_form" class="btn btn-primary">更新する</button>
          </li>
          <li>
            <%= button_to "前の画面に戻る", aircraft_list_index_path, method: :get,
              class: "btn btn-secondary",style: "margin-left: 100px;",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
        </ul>
    </div>

    <%= form_with model: @aircraft, url: aircraft_update_path, method: :patch, local: true, html: { id: "aircraft_edit_form" } do |f| %>

  <!-- アラート表示 -->
    <% if @aircraft.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @aircraft.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="box3 overflow-x-auto box3--flex">
    <!-- box3貼り付け部 -->
      <div style="min-width: 600px;">

        <span class="fs-5 text-center " style="margin-left: 20px;" >1.DIPS情報</span>   
        <table class="table table-bordered table-sm w-100">
          <thead>
            <tr style="text-align: center;">
              <th scope="col" >項目</th>
              <th scope="col">設定</th>
            </tr>
          </thead>

          <tbody class="table-group-divider">
            <tr style="text-align: center;">
              <th scope="col">登録番号(DIPS)</th>

              <td style="text-align: center;">
                <%= f.text_field :dips_registration_number,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:JU0123456" %>
              </td>

            </tr>

            <tr style="text-align: center;">
              <th scope="col">種類</th>
              <td style="text-align: center;">
                <%= f.select :dips_type,
                      options_for_select(
                        [["種類選択", ""],
                         ["回転翼航空機(マルチローター)", "1"],
                         ["回転翼航空機(ヘリコプター)", "2"],
                         ["飛行機", "3"],
                         ["パワードリフト", "4"]],
                        f.object.dips_type
                      ),
                      {},
                      { class: "form-select form-select-sm border border-secondary text-center" } %>
              </td>
            </tr>

            <%= render 'shared/dips_model_select', f: f %>

            <%= render 'shared/dips_type_approval_number_select', f: f %>

            <%= render 'shared/dips_aircraft_registration_category_select', f: f %>

            <tr style="text-align: center;">
              <th scope="col">設計製造者</th>
              <td style="text-align: center;">
                <%= f.text_field :dips_designer_and_manufacturer,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:DJI" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">シリアル番号</th>

              <td style="text-align: center;">
                <%= f.text_field :dips_serial_number,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:12345678" %>
              </td>
            </tr>

          </tbody>
        </table>
      </div>

      <div style="min-width: 600px;">

        <span class="fs-5 text-center" style="margin-left: 20px;" >2.ユーザ情報</span>   
        <table class="table table-bordered table-sm w-100">
          <thead>
            <tr style="text-align: center;">
              <th scope="col">項目</th>
              <th scope="col">設定</th>
            </tr>
          </thead>

          <tbody class="table-group-divider">
            <tr style="text-align: center;">
              <th scope="col">購入メーカ</th>

              <td style="text-align: center;">
                <%= f.text_field :owner_manufacturer,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:DJI" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">購入型式</th>
              <td style="text-align: center;">
                <%= f.text_field :model_purchased,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:DJI Mini3" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">機体購入日</th>

              <td style="text-align: center;">
                <%= f.date_field :owner_date_purchased,
                      class: "form-control form-control-sm text-center border border-secondary",
                      style: "height: 28px;" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">登録者</th>
              <td style="text-align: center;">
                <%= f.text_field :owner_name,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "名前" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">リモートID登録番号</th>

              <td style="text-align: center;">
                <%= f.text_field :remote_id_registration_number,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:3456789" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">保険会社</th>
              <td style="text-align: center;">
                <%= f.text_field :owner_insurance_company,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:損保ジャパン" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">保険証券番号</th>

              <td style="text-align: center;">
                <%= f.text_field :owner_policy_number,
                      class: "form-control form-control-sm text-center border border-secondary",
                      placeholder: "例:112050" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">保険加入日</th>
              <td style="text-align: center;">
                <%= f.date_field :owner_insurance_start_date,
                      class: "form-control form-control-sm text-center border border-secondary",
                      style: "height: 28px;" %>
              </td>
            </tr>

            <tr style="text-align: center;">
              <th scope="col">保険満了日</th>
              <td style="text-align: center;">
                <%= f.date_field :owner_insurance_expiration_date,
                      class: "form-control form-control-sm text-center border border-secondary",
                      style: "height: 28px;" %>
              </td>

            </tr>

          </tbody>
        </table>
      </div>

    <!-- box3貼り付け部 終了-->
    </div>
    <% end %>
  </div>
</turbo-frame>