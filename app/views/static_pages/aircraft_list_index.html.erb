<turbo-frame id="main_content"> 

 <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 150px;">機体一覧</span></li>
          <li>
            <label class="fs-5">開始日</label> 
            <input type="date" id="startDate">
          </li>
          <li>
            <label class="fs-5" style="margin-left: 10px;">終了日</label>
            <input type="date" id="endDate" style="margin-right: 20px;">
          </li>
          <li>
            <button type="button" class="btn btn-secondary btn-sm">検索</button>
          </li>
          <li>
            <%= button_to "新規作成", aircraft_new_path, method: :get,
              class: "btn btn-primary btn-sm ms-3",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
        </ul>
    </div>
 
    <div class="box3 overflow-x-auto box3--plain">
    <!-- box3貼り付け部 -->

    <!-- 飛行機体一覧 2026.6/22 dbデータ表示 -->
      <% if @aircrafts.present? %>
          <% @aircrafts.each do |aircraft| %>
            <!--    <table class="table table-sm"> -->
            <table class="table table-bordered table-sm">
              <thead>
                <tr class="text-center">
                  <th scope="col">ID</th>
                  <th scope="col">メーカ</th>
                  <th scope="col">飛行機体</th>
                  <th scope="col">機体登録者</th>
                  <th scope="col">機体購入日</th>
                  <th scope="col">操作</th>
                </tr>
              </thead>

              <tbody class="table-group-divider text-center">
                <tr>
                  <th scope="row">  <%= aircraft.id %>        </th>
                  <td>  <%= aircraft.owner_manufacturer %>    </td>
                  <td>  <%= aircraft.model_purchased %>       </td>
                  <td>  <%= aircraft.owner_name %>            </td>
                  <td>  <%= aircraft.owner_date_purchased %>  </td>
                  <td class="d-flex gap-3 justify-content-left">

                    <%= button_to "詳細", aircraft_show_path(aircraft.id), method: :get,
                      class: "btn btn-info btn-sm ms-3",
                      form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>

                    <%= button_to "編集", aircraft_edit_path(aircraft.id), method: :get,
                      class: "btn btn-success btn-sm ms-3",
                      form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>

                    <button type="button" class="btn btn-danger btn-sm ms-3"
                      onclick="window.open('<%= delete_confirm_index_path(aircraft.id) %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
        <% end %>

      <% else %>
        <div class="mb-3">データがありません。</div>
      <% end %>

    </div>
  </div>
</turbo-frame>