<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">機体詳細</span></li>

          <li><span class="fs-4" style="margin-right: 20px;">機体ID: <%= @aircraft.id %> </span></li>

          <li>
            <%= button_to "編集", aircraft_edit_path(@aircraft.id), method: :get,
              class: "btn btn-success btn-sm ms-3",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
          <li>
            <button type="button" class="btn btn-danger btn-sm ms-3"
              onclick="window.open('<%= delete_confirm_index_path(@aircraft.id) %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
            </button>
          </li>
        </ul>
    </div>
 
    <div class="box3 overflow-x-auto box3--flex">
    <!-- box3貼り付け部 -->
      <div style="min-width: 600px;">
 
        <span class="fs-5 text-center " style="margin-left: 20px;" >1.DIPS情報</span>   
        <table class="table table-bordered table-sm w-100">
          <thead>
            <tr style="text-align: center;">
              <th scope="col" >項目</th>
              <th scope="col">設定</th>
            </tr>
          </thead>

        <!-- 機体詳細 2026.6/25 dbデータ表示 -->  

        <tbody class="table-group-divider">
            <tr style="text-align: left;">
              <th scope="col">登録番号</th>
              <th scope="col"> <%= @aircraft.dips_registration_number %>        </th>
            </tr>

            <tr style="text-align: left;"> 
              <th scope="col">種類</th>
              <th scope="col"> <%= @aircraft.dips_type %>                       </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">型式</th>
              <th scope="col"> <%= @aircraft.dips_model %>                      </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">型式認証番号</th>
              <th scope="col"> <%= @aircraft.dips_type_approval_number %>       </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">機体認証の区分及び機体認証番号</th>
              <th scope="col"> <%= @aircraft.dips_aircraft_registration_category %> </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">設計製造者</th>
              <th scope="col"> <%= @aircraft.dips_designer_and_manufacturer %>  </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">シリアル番号</th>
              <th scope="col"> <%= @aircraft.dips_serial_number %>              </th>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="min-width: 600px;">
        <span class="fs-5 text-center" style="margin-left: 20px;" >2.ユーザ情報</span>   
        <table class="table table-bordered table-sm w-100">
          <thead>
            <tr style="text-align: center;">
              <th scope="col">項目</th>
              <th scope="col">設定</th>
            </tr>
          </thead>

          <tbody class="table-group-divider">
            <tr style="text-align: left;">
              <th scope="col">購入メーカ</th>
              <th scope="col"> <%= @aircraft.owner_manufacturer %>              </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">購入型式</th>
              <th scope="col"> <%= @aircraft.model_purchased %>                 </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">機体購入日</th>
              <th scope="col"> <%= @aircraft.owner_date_purchased %>            </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">機体所有者</th>
              <th scope="col"> <%= @aircraft.owner_name %>                      </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">リモートID登録番号</th>
              <th scope="col"> <%= @aircraft.remote_id_registration_number %>   </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険会社</th>

              <th scope="col"> <%= @aircraft.owner_insurance_company %>         </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険証券番号</th>
              <th scope="col"> <%= @aircraft.owner_policy_number %>             </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険加入日</th>
              <th scope="col"> <%= @aircraft.owner_insurance_start_date %>      </th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険満了日</th>
              <th scope="col"> <%= @aircraft.owner_insurance_expiration_date %> </th>
            </tr>

          </tbody>
        </table>
      </div>

    <!-- box3貼り付け部 終了-->
    </div>
  </div>
</turbo-frame>