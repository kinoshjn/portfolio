<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">機体詳細</span></li>

          <li><span class="fs-4" style="margin-right: 20px;">ID: 1</span></li>

          <li>
            <%= button_to "編集", aircraft_edit_path, method: :get,
              class: "btn btn-success btn-sm ms-3",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
          <li>
            <button type="button" class="btn btn-danger btn-sm ms-3"
              onclick="window.open('<%= delete_confirm_index_path %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
            </button>
          </li>
        </ul>
    </div>
 
    <div class="box3 overflow-x-auto box3--flex">

    <!-- box3貼り付け部 -->

      <div style="min-width: 600px;">
 
        <span class="fs-5 text-center " style="margin-left: 20px;" >1.基本情報</span>   
        <table class="table table-bordered table-sm w-100">
          <thead>
            <tr style="text-align: center;">
              <th scope="col" >項目</th>
              <th scope="col">設定</th>
            </tr>
          </thead>

          <tbody class="table-group-divider">
            <tr style="text-align: left;">
              <th scope="col">登録番号(DIPS)</th>
              <th scope="col">JUxxxxxxxxx</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">種類</th>
              <th scope="col">回転翼航空機(マルチローター)</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">型式</th>
              <th scope="col">なし(型式認証なし)</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">型式認証番号</th>
              <th scope="col">なし(型式認証なし)</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">機体認証の区分及び機体認証番号</th>
              <th scope="col">なし(型式認証なし)</th>

            </tr>

            <tr style="text-align: left;">
              <th scope="col">設計製造者</th>
              <th scope="col">DJI</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">シリアル番号</th>
              <th scope="col">xxxxxxxxx</th>
            </tr>

          </tbody>
        </table>
      </div>

      <div style="min-width: 600px;">
        <span class="fs-5 text-center" style="margin-left: 20px;" >2.追加情報</span>   
        <table class="table table-bordered table-sm w-100">
          <thead>
            <tr style="text-align: center;">
              <th scope="col">項目</th>
              <th scope="col">設定</th>
            </tr>
          </thead>

          <tbody class="table-group-divider">
            <tr style="text-align: left;">
              <th scope="col">購入メーカ</th>
              <th scope="col">DJI</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">購入型式</th>
              <th scope="col">DJI Mini3</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">機体購入日</th>
              <th scope="col">2026/05/20</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">登録者</th>
              <th scope="col">山田太郎</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">リモートID登録番号</th>
              <th scope="col">XXXXXXX</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険会社</th>
              <th scope="col">XXXXX</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険証券番号</th>
              <th scope="col">XXXXXXXX</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険加入日</th>
              <th scope="col">2026/05/24</th>
            </tr>

            <tr style="text-align: left;">
              <th scope="col">保険満了日</th>
              <th scope="col">2027/05/23</th>
            </tr>

          </tbody>
        </table>
      </div>

    <!-- box3貼り付け部 終了-->
    </div>
  </div>
</turbo-frame>