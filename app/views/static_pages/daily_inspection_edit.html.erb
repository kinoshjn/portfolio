
<turbo-frame id="main_content"> 
  <div class="wrapper">
    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 

    <!-- アラート表示 -->
    <% if @daily_inspection.errors.any? %>
      <div class="alert alert-danger" style="max-width: 800px;">
        <ul class="mb-0">
          <% @daily_inspection.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">日常点検編集</span></li>
          <li><span class="fs-4" style="margin-right: 20px;">ID: <%= @daily_inspection.id %></span></li>
          <li>
            <button type="submit" form="daily_inspection_edit_form" class="btn btn-primary">更新する</button>
          </li>
          <li>
            <%= button_to "前の画面に戻る", daily_inspection_index_path , method: :get,
              class: "btn btn-secondary",style: "margin-left: 100px;",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
        </ul>

    </div>

    <%= form_with model: @daily_inspection, url: daily_inspection_update_path(@daily_inspection.id), method: :patch, local: true, html: { id: "daily_inspection_edit_form" } do |f| %>

    <div class="box3 overflow-x-auto box3--plain">

      <table class="table table-bordered table-sm" >
        <thead>
          <tr class="text-center">
            <th scope="col" style="width: 150px; height: auto;">項目</th>
            <th scope="col" style="width: 400px; height: auto;">確認内容</th>
            <th scope="col" style="width: 150px; height: auto;">結果</th>
            <th scope="col">備考</th>
          </tr>
        </thead>

        <tbody class="table-group-divider text-left" id="daily_inspection_items_body">
        </tbody>
      </table>

      <table class="table table-bordered table-sm" >
        <thead>
          <tr class="text-center">
            <th scope="col" style="width: 100px; height: auto;">項目</th>
            <th scope="col" style="width: 400px; height: auto;">内容</th>
          </tr>
        </thead>

        <tbody class="table-group-divider text-left">
          <tr>
            <th scope="row">飛行機体</th>
            <td>
              <span class="fs-6"><%= current_user.aircraft&.model_purchased %></span>
              <%= f.hidden_field :aircraft_id, value: current_user.aircraft&.id %>
            </td>
          </tr>
          <tr>
            <th scope="row">無人飛行機の登録番号</th>
            <td><%= current_user.aircraft&.dips_registration_number %></td>
          </tr>

          <tr>
            <th scope="row">点検日</th>
            <td style="text-align: center;">
              <%= f.date_field :inspection_date,
                    class: "form-control form-control-sm text-left border border-secondary",
                    style: "width: 100%; height: 31px; display: inline-block;" %>
            </td>
          </tr>
          <tr>
            <th scope="row">点検場所</th>
            <td style="text-align: center;">
              <%= f.text_field :inspection_location,
                    class: "form-control form-control-sm text-left border border-secondary",
                    placeholder: "住所", style: "width: 100%; display: inline-block;" %>
            </td>
          </tr>
          <tr>
            <th scope="row">点検者</th>
            <td style="text-align: center;">
              <%= f.text_field :inspector,
                    class: "form-control form-control-sm text-left border border-secondary",
                    placeholder: "名前", style: "width: 100%; display: inline-block;" %>
            </td>
          </tr>
          <tr>
            <th scope="row">特記事項</th>
            <td style="text-align: center;">
              <%= f.text_field :special_notes,
                    class: "form-control form-control-sm text-left border border-secondary",
                    style: "width: 100%; display: inline-block;" %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <% end %>

    <%# 既存データをJavaScriptに渡す %>
    <script>
    (function() {
      const itemNotes = {
        "機体全般": "機器の取り付け状態（ネジ、コネクタ、ケーブル等）",
        "プロペラ": "外観、損傷、ゆがみ",
        "フレーム": "外観、損傷、ゆがみ",
        "通信系統": "機体と操縦装置の通信品質の健全性",
        "推進系統": "モーター又は発動機の健全性",
        "電源系統": "機体及び操縦装置の電源の健全性",
        "自動制御系統": "飛行制御装置の健全性",
        "操作装置": "外観、スティックの健全性、スイッチの健全性",
        "バッテリー・燃料": "バッテリーの充電状況、残燃料表示機能の健全性"
      };

      const existingItems = <%= raw @daily_inspection.daily_inspection_items.map { |item|
        {
          id: item.id,
          item_name: item.item_name,
          result: item.result,
          note: item.note
        }
      }.to_json %>;

      const itemNames = Object.keys(itemNotes);
      const tbody = document.getElementById('daily_inspection_items_body');

      itemNames.forEach(function(name, index) {
        const existing = existingItems.find(function(e) { return e.item_name === name; });
        const id = existing ? existing.id : '';
        const result = existing ? existing.result : '';
        const note = existing ? existing.note : '';

        const row = `
          <tr>
            <th scope="row">${name}</th>
            <td>${itemNotes[name]}</td>
            <td>
              <input type="hidden" name="daily_inspection[daily_inspection_items_attributes][${index}][id]" value="${id}">
              <input type="hidden" name="daily_inspection[daily_inspection_items_attributes][${index}][item_name]" value="${name}">
              <select class="form-select form-select-sm border border-secondary text-center" name="daily_inspection[daily_inspection_items_attributes][${index}][result]">
                <option value="">選択</option>
                <option value="1" ${result === '1' ? 'selected' : ''}>合格</option>
                <option value="2" ${result === '2' ? 'selected' : ''}>不合格</option>
              </select>
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" name="daily_inspection[daily_inspection_items_attributes][${index}][note]" value="${note || ''}" style="width: 100%; display: inline-block;">
            </td>
          </tr>`;
        tbody.insertAdjacentHTML('beforeend', row);
      });
    })();
    </script>

  </div>
</turbo-frame>