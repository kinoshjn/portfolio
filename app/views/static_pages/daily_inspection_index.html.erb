<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
      <%= search_form_for @q do |f| %>
      <ul class="main-nav font-english">
        <li><span class="fs-3" style="margin-right: 20px;">日常点検一覧</span></li>
        <li>
          <%= f.label :inspection_date_gteq, "開始日", class: "fs-5" %>
          <%= f.date_field :inspection_date_gteq %>
        </li>
        <li>
          <%= f.label :inspection_date_lteq, "終了日", class: "fs-5", style: "margin-left: 10px;" %>
          <%= f.date_field :inspection_date_lteq, style: "margin-right: 20px;" %>
        </li>
        <li>
          <%= f.submit "絞込み", class: "btn btn-secondary btn-sm" %>
        </li>
      </ul>
      <% end %>

      <ul class="main-nav font-english">
        <li>
          <%= button_to "新規作成", flight_log_new_path, method: :get,
            class: "btn btn-primary btn-sm ms-3",
            form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
        </li>
      </ul>
    </div>

    <div class="box3 overflow-x-auto box3--plain">
    <!-- box3貼り付け部 -->

    <!-- 日常点検一覧 2026.6/24 dbデータ表示 -->

    <% if @daily_inspections.present? %> 
      <table class="table table-bordered table-sm">
        <thead>
          <tr class="text-center">
            <th scope="col">日常点検ID</th>
            <th scope="col">実施日</th>
            <th scope="col">飛行機体</th>
            <th scope="col">実施者</th>
            <th scope="col">実施場所</th>
            <th scope="col">操作</th>
          </tr>
        </thead>
        <tbody class="table-group-divider text-center">
          <% @daily_inspections.each do |daily_inspection| %> 

            <tr>
              <th scope="row">  <%= daily_inspection.id %>                          </th>
              <td>              <%= daily_inspection.inspection_date %>             </td>
              <td>              <%= daily_inspection.aircraft.model_purchased %>    </td> 
              <td>              <%= daily_inspection.inspector %>                   </td>
              <td class="text-start">  <%= daily_inspection.inspection_location %>  </td>

              <td class="d-flex gap-3 justify-content-left">
                <%= button_to "詳細", daily_inspection_path(daily_inspection.id), method: :get,
                  class: "btn btn-info btn-sm ms-3",
                  form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>

                <%= button_to "編集", daily_inspection_edit_path(daily_inspection.id), method: :get,
                  class: "btn btn-success btn-sm ms-3",
                  form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>

                <button type="button" class="btn btn-danger btn-sm ms-3"
                  onclick="window.open('<%= delete_confirm_index_path(id: daily_inspection.id, type: :daily_inspection) %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    <% else %>
      <div class="mb-3">データがありません。(機体登録を先に実施ください)</div>
    <% end %>

    </div>
  </div>
</turbo-frame>