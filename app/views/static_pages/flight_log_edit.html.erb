<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2" style="overflow-x: auto;">
      <ul class="main-nav font-english">
        <li><span class="fs-3" style="margin-right: 10px;">飛行日誌編集</span></li>
        <li><span class="fs-4" style="margin-right: 20px;">ID: <%= @flight_log.id %></span></li>
        <li>
          <button type="submit" form="flight_log_edit_form" class="btn btn-primary">更新する</button>
        </li>
        <li>
          <%= button_to "編集", flight_log_edit_path(@flight_log.id), method: :get,
            class: "btn btn-secondary", style: "margin-left: 100px;",
            form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
        </li>
      </ul>
    </div>

    <%= form_with model: @flight_log, url: flight_log_update_path(@flight_log.id), method: :patch, local: true, html: { id: "flight_log_edit_form" } do |f| %>

    <div class="box3 overflow-x-auto box3--plain">

      <div class="d-flex flex-wrap gap-3 mb-1">
        <label style="margin-left: 70px;" class="d-inline-flex align-items-center gap-2">
          <span class="fs-4">飛行日:</span>
          <%= f.date_field :flight_date,
                class: "form-control text-center border border-secondary",
                style: "width: 150px; height: 40px; display: inline-block;" %>
        </label>

        <label style="margin-left: 70px;" class="d-inline-flex align-items-center gap-2">
          <span class="fs-4">飛行機体:</span>
          <span class="fs-5"><%= current_user.aircraft&.model_purchased %></span>
          <%= f.hidden_field :aircraft_id, value: current_user.aircraft&.id %>
        </label>

        <button type="button" class="btn btn-secondary btn-sm" id="add_flight_record_btn">行追加</button>
        <button type="button" class="btn btn-danger btn-sm" id="remove_flight_record_btn">行削除</button>
      </div>

      <%# 上段テーブル(FlightRecord) %>
      <table class="table table-bordered table-sm">
        <thead>
          <tr style="text-align: center;">
            <th scope="col">内訳</th>
            <th scope="col">飛行者</th>
            <th scope="col">離陸時刻</th>
            <th scope="col">着陸時刻</th>
            <th scope="col">飛行時間</th>
            <th scope="col">総飛行時間</th>
            <th scope="col">飛行離陸場所</th>
            <th scope="col">飛行着陸場所</th>
            <th scope="col">飛行概要</th>
            <th scope="col">安全・影響</th>
          </tr>
        </thead>
        <tbody class="table-group-divider" id="flight_records_body">
        </tbody>
      </table>

      <%# 下段テーブル(SafetyIncident) %>
      <table class="table table-bordered table-sm">
        <thead>
          <tr style="text-align: center;">
            <th scope="col">内訳</th>
            <th scope="col">不具合事項</th>
            <th scope="col">処置日</th>
            <th scope="col">処置内容</th>
            <th scope="col">確認者</th>
          </tr>
        </thead>
        <tbody class="table-group-divider" id="safety_incidents_body">
        </tbody>
      </table>

    </div>
    <% end %>

    <%# 既存データをJavaScriptに渡す %>
    <script>
    (function() {
      const existingRecords = <%= raw @flight_log.flight_records.map { |fr|
        {
          id: fr.id,
          pilot_name: fr.pilot_name,
          takeoff_time: fr.takeoff_time&.strftime("%H:%M"),
          landing_time: fr.landing_time&.strftime("%H:%M"),
          takeoff_location: fr.takeoff_location,
          landing_location: fr.landing_location,
          flight_summary: fr.flight_summary,
          has_safety_incident: fr.has_safety_incident,
          safety_incident: fr.safety_incident ? {
            id: fr.safety_incident.id,
            details_issues: fr.safety_incident.details_issues,
            details_date_resolution: fr.safety_incident.details_date_resolution&.strftime("%Y-%m-%d"),
            details_processing: fr.safety_incident.details_processing,
            details_verifier: fr.safety_incident.details_verifier
          } : nil
        }
      }.to_json %>;

      let rowCount = 0;

      function addFlightRecord(data) {
        const tbody = document.getElementById('flight_records_body');
        const newIndex = rowCount;
        const rowNum = rowCount + 1;

        if (rowNum > 10) {
          alert('最大10行まで追加できます');
          return;
        }

        const id = data ? data.id : '';
        const pilotName = data ? data.pilot_name : '';
        const takeoffTime = data ? data.takeoff_time : '';
        const landingTime = data ? data.landing_time : '';
        const takeoffLocation = data ? data.takeoff_location : '';
        const landingLocation = data ? data.landing_location : '';
        const flightSummary = data ? data.flight_summary : '';
        const hasSafetyIncident = data ? data.has_safety_incident : false;

        const newRow = `
          <tr>
            <th scope="row" style="text-align: center;">${rowNum}</th>
            <td style="text-align: center;">
              <input type="hidden" name="flight_log[flight_records_attributes][${newIndex}][id]" value="${id}">
              <input class="form-control form-control-sm text-center border border-secondary" type="text" placeholder="名前" name="flight_log[flight_records_attributes][${newIndex}][pilot_name]" value="${pilotName}" style="width: 90px; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-center border border-secondary" type="time" name="flight_log[flight_records_attributes][${newIndex}][takeoff_time]" value="${takeoffTime}" style="width: 80px; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-center border border-secondary" type="time" name="flight_log[flight_records_attributes][${newIndex}][landing_time]" value="${landingTime}" style="width: 80px; display: inline-block;">
            </td>
            <td style="text-align: center;"></td>
            <td style="text-align: center;"></td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="住所1" name="flight_log[flight_records_attributes][${newIndex}][takeoff_location]" value="${takeoffLocation}" style="width: 240px; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="住所2" name="flight_log[flight_records_attributes][${newIndex}][landing_location]" value="${landingLocation}" style="width: 240px; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-center border border-secondary" type="text" placeholder="概要" name="flight_log[flight_records_attributes][${newIndex}][flight_summary]" value="${flightSummary}" style="width: 130px; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <select class="form-select form-select-sm border border-secondary text-center" name="flight_log[flight_records_attributes][${newIndex}][has_safety_incident]">
                <option value="">選択</option>
                <option value="false" ${!hasSafetyIncident ? 'selected' : ''}>なし</option>
                <option value="true" ${hasSafetyIncident ? 'selected' : ''}>あり</option>
              </select>
            </td>
          </tr>`;

        tbody.insertAdjacentHTML('beforeend', newRow);

        const siTbody = document.getElementById('safety_incidents_body');
        const siId = data && data.safety_incident ? data.safety_incident.id : '';
        const detailsIssues = data && data.safety_incident ? data.safety_incident.details_issues : '';
        const detailsDate = data && data.safety_incident ? data.safety_incident.details_date_resolution : '';
        const detailsProcessing = data && data.safety_incident ? data.safety_incident.details_processing : '';
        const detailsVerifier = data && data.safety_incident ? data.safety_incident.details_verifier : '';

        const siRow = `
          <tr>
            <th scope="row" style="text-align: center;">${rowNum}</th>
            <td style="text-align: center;">
              <input type="hidden" name="flight_log[flight_records_attributes][${newIndex}][safety_incident_attributes][id]" value="${siId}">
              <input class="form-control form-control-sm text-center border border-secondary" type="text" placeholder="不具合内容" name="flight_log[flight_records_attributes][${newIndex}][safety_incident_attributes][details_issues]" value="${detailsIssues}" style="width: 100%; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-center border border-secondary" type="date" name="flight_log[flight_records_attributes][${newIndex}][safety_incident_attributes][details_date_resolution]" value="${detailsDate}" style="width: 150px; height: 31px; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-center border border-secondary" type="text" placeholder="処置内容" name="flight_log[flight_records_attributes][${newIndex}][safety_incident_attributes][details_processing]" value="${detailsProcessing}" style="width: 100%; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-center border border-secondary" type="text" placeholder="名前" name="flight_log[flight_records_attributes][${newIndex}][safety_incident_attributes][details_verifier]" value="${detailsVerifier}" style="width: 90px; display: inline-block;">
            </td>
          </tr>`;
        siTbody.insertAdjacentHTML('beforeend', siRow);

        rowCount++;
      }

      function removeFlightRecord() {
        const tbody = document.getElementById('flight_records_body');
        const rows = tbody.querySelectorAll('tr');
        if (rows.length <= 1) {
          alert('最低1行は必要です');
          return;
        }
        tbody.removeChild(rows[rows.length - 1]);
        rowCount--;

        const siTbody = document.getElementById('safety_incidents_body');
        const siRows = siTbody.querySelectorAll('tr');
        if (siRows.length > 0) {
          siTbody.removeChild(siRows[siRows.length - 1]);
        }
      }

      // 既存データを初期表示
      existingRecords.forEach(function(record) {
        addFlightRecord(record);
      });

      document.getElementById('add_flight_record_btn').addEventListener('click', function() {
        addFlightRecord(null);
      });
      document.getElementById('remove_flight_record_btn').addEventListener('click', removeFlightRecord);
    })();
    </script>

  </div>
</turbo-frame>