<turbo-frame id="main_content"> 

  <div class="wrapper">
    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2" style="overflow-x: auto;">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">飛行日誌詳細</span></li>
          <li><span class="fs-4" style="margin-right: 20px;">飛行日誌ID: <%= @flight_log.id %> </span></li>
          <li>
            <%= button_to "編集", flight_log_edit_path, method: :get,
              class: "btn btn-success btn-sm ms-3",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
          <li>
            <button type="button" class="btn btn-danger btn-sm ms-3"
              onclick="window.open('<%= delete_confirm_index_path %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
            </button>
          </li>
        </ul>
    </div>

    <div class="box3 overflow-x-auto box3--plain">
    <!-- box3貼り付け部 -->


 <!-- <table class="table table-sm"> -->
    <div class="d-flex flex-wrap gap-3 mb-1">
      <h5>飛行日: <%= @flight_log.flight_date  %> </h5>
      <h5>飛行機体: <%= @flight_log.aircraft.model_purchased %> </h5>        
      <h5>無人飛行機の登録番号: <%= @flight_log.aircraft.dips_registration_number %> </h5>
    </div>

      <table class="table table-bordered table-sm">
        <thead>
          <tr style="text-align: center;">
            <th scope="col">RecordID</th>
            <th scope="col">操縦者</th>
            <th scope="col">離陸時刻</th>
            <th scope="col">着陸時刻</th>
            <th scope="col">飛行時間</th>
            <th scope="col">総飛行時間</th>
            <th scope="col">飛行離陸場所</th>
            <th scope="col">飛行着陸場所</th>
            <th scope="col">飛行概要</th>
            <th scope="col">安全・影響事項</th>
          </tr>
        </thead>

        <tbody class="table-group-divider">

        <% @flight_log.flight_records.each do |flight_record| %>
          <tr>
            <th scope="row" style="text-align: center;">  <%= flight_record.id %>                   </th>
            <td>  <%= flight_record.pilot_name %>                       </td>
            <td style="text-align: center;">  <%= flight_record.takeoff_time.strftime("%H:%M") %>   </td>
            <td style="text-align: center;">  <%= flight_record.landing_time.strftime("%H:%M") %>   </td>
            <td style="text-align: center;">  <%= flight_record.flight_time %>分                    </td>
            <td style="text-align: center;">  <%= flight_record.total_flight_time %>分              </td>
            <td>  <%= flight_record.takeoff_location %>                       </td>
            <td>  <%= flight_record.landing_location %>                       </td>
            <td style="text-align: center;">  <%= flight_record.flight_summary %>                   </td>
            <td style="text-align: center;">  <%= flight_record.has_safety_incident ? "あり" : "なし" %> </td>
          </tr>
        <% end %>
        </tbody>
      </table>


      <table class="table table-bordered table-sm">
        <thead>
          <tr style="text-align: center;">
            <th scope="col">安全・影響事項</th>
            <th scope="col">不具合事項</th>
            <th scope="col">処置日</th>
            <th scope="col">処置内容</th>
            <th scope="col">確認者</th>
          </tr>
        </thead>

        <tbody class="table-group-divider">

        <% @flight_log.flight_records.each do |flight_record| %>
          <% if flight_record.has_safety_incident %>
            <% incident = flight_record.safety_incident %>
            <tr>
              <th scope="row" style="text-align: center;"><%= flight_record.id %></th>
              <td style="text-align: center;"><%= incident.details_issues %></td>
              <td style="text-align: center;"><%= incident.details_date_resolution.strftime("%Y/%-m/%-d") %></td>
              <td style="text-align: center;"><%= incident.details_processing %></td>
              <td style="text-align: center;"><%= incident.details_verifier %></td>
            </tr>
          <% end %>
        <% end %>
        </tbody>
      </table>

    <!-- box3貼り付け部 終了  -->
    </div>
  </div>
</turbo-frame>
