<turbo-frame id="main_content"> 
  <div class="wrapper"> 
    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
      <h3 class="fw-normal">問い合わせ</h3> 
    </div>

    <div class="box3 overflow-x-auto box3--plain">

      <!-- 問い合わせフォーム -->

        <%= form_with url: inquiries_create_path, method: :post do |f| %>
          <div class="mb-3">
            <%= f.label :content, "問い合わせ内容", class: "form-label" %>
            <%= f.text_area :content, class: "form-control", rows: 8 %>
          </div>

          <div class="mb-3">
            <%= f.submit "内容を送信", class: "btn btn-primary" %>
          </div>
        <% end %> 

    </div>
  </div>
</turbo-frame> 