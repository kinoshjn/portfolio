<turbo-frame id="main_content"> 
  <div class="wrapper"> 
    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
      <h3 class="fw-normal">問い合わせ</h3> 
    </div>

    <div class="box3 overflow-x-auto box3--plain">

      <!-- 問い合わせフォーム -->

        <form class="col-lg-8 mb-3">
          <div class="mb-3">
            <label for="exampleInputName1" class="form-label">名前</label>
            <input type="text" class="form-control" placeholder="" aria-label="Username" aria-describedby="basic-addon1">

          </div>

          <div class="mb-3">
            <label for="exampleInputEmail1" class="form-label">メールアドレス</label>
            <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
          </div>

          <div class="mb-3">
            <label for="exampleFormControlTextarea1" class="form-label">問い合わせ内容</label>
            <textarea class="form-control" id="exampleFormControlTextarea1" rows="8"></textarea>
          </div>
          <div>
            <button type="submit" class="btn btn-primary" >内容を送信</button>
          </div>
        </form>

    </div>
  </div>
</turbo-frame> 