<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
    <!-- box1貼り付け部 -->
      <side_board>
        <ul class="side_board-nav font-english">
          <li><%= link_to "機体一覧", aircraft_list_index_path, data: { turbo_frame: "main_content" } %></li>
          <li><%= link_to "飛行日誌一覧", flight_log_index_path, data: { turbo_frame: "main_content" } %></li>
          <li><%= link_to "日常点検一覧", daily_inspection_index_path, data: { turbo_frame: "main_content" } %></li>
          <li><%= link_to "点検整備一覧", inspection_and_maintenance_index_path, data: { turbo_frame: "main_content" } %></li>
        </ul>

        <div class="text-left">
          <%= image_tag "logo2.png", class: "rounded", alt: "アバター", style: "margin-left: 20px; width: 150px; height: auto;" %>
        </div>

      </side_board>
    <!-- box1貼り付け部 修了-->
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">点検整備詳細</span></li>
          <li><span class="fs-4" style="margin-right: 20px;">ID: 1</span></li>

          <li>
            <%= button_to "編集", inspection_and_maintenance_edit_path, method: :get,
              class: "btn btn-success btn-sm ms-3",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>

          <li>
            <button type="button" class="btn btn-danger btn-sm ms-3"
              onclick="window.open('<%= delete_confirm_index_path %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
            </button>
          </li>
        </ul>
    </div>

    <div class="box3 overflow-x-auto box3--plain">
    <!-- box3貼り付け部 -->

