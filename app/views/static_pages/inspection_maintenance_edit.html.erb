<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %>

    <!-- アラート表示 -->
    <% if @inspection_maintenance.errors.any? %>
      <div class="alert alert-danger" style="max-width: 1200px;">
        <ul class="mb-0">
          <% @inspection_maintenance.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">点検整備編集</span></li>
          <li><span class="fs-4" style="margin-right: 20px;">ID: <%= @inspection_maintenance.id %></span></li>
          <li>
            <button type="submit" form="inspection_maintenance_edit_form" class="btn btn-primary">更新する</button>
          </li>
          <li>
            <button type="button" class="btn btn-secondary btn-sm" id="add_item_btn">行追加</button>
          </li>
          <li>
            <button type="button" class="btn btn-danger btn-sm" id="remove_item_btn">行削除</button>
          </li>
          <li>
            <%= button_to "前の画面に戻る",     inspection_maintenance_index_path    , method: :get,
              class: "btn btn-secondary",style: "margin-left: 100px;",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>
        </ul>
    </div>

    <%= form_with model: @inspection_maintenance, url: inspection_maintenance_update_path(@inspection_maintenance.id), method: :patch, local: true, html: { id: "inspection_maintenance_edit_form" } do |f| %>

    <div class="box3 overflow-x-auto box3--plain">

      <table class="table table-bordered table-sm text-center" style="table-layout: fixed; width: 1220px;">

        <thead>
          <tr class="text-center">
            <th scope="col" style="width: 135px; height: auto;">実施日</th>
            <th scope="col" style="width: 100px; height: auto;">総飛行時間</th>
            <th scope="col" style="height: auto;">点検、修理、改造及び整備の内容</th>
            <th scope="col" style="width: 260px; height: auto;">実施理由</th>
            <th scope="col" style="width: 240px; height: auto;">実施場所</th>
            <th scope="col" style="width: 90px; height: auto;">実施者</th>
            <th scope="col" style="width: 160px; height: auto;">備考</th>
          </tr>
        </thead>

        <tbody class="table-group-divider text-left" id="inspection_items_body">
        </tbody>
      </table>

      <table class="table table-bordered table-sm text-center" style="table-layout: fixed; width: 730px;">
        <thead>
          <tr class="text-center">
            <th scope="col" style="width: 235px; height: auto;">項目</th>
            <th scope="col" style="height: auto;">内容</th>
          </tr>
        </thead>

        <tbody class="table-group-divider text-start">
          <tr>
            <th scope="row">飛行機体</th>
            <td>
              <span class="fs-6"><%= current_user.aircraft&.model_purchased %></span>
              <%= f.hidden_field :aircraft_id, value: current_user.aircraft&.id %>
            </td>
          </tr>
          <tr>
            <th scope="row">無人飛行機の登録番号</th>
            <td><%= current_user.aircraft&.dips_registration_number %></td>
          </tr>
          <tr>
            <th scope="row">特記事項</th>
            <td>
              <%= f.text_area :special_notes,
                    class: "form-control form-control-sm border border-secondary",
                    rows: 3 %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <% end %>

    <%# 既存データをJavaScriptに渡す %>
    <script>
    (function() {
      const existingItems = <%= raw @inspection_maintenance.inspection_maintenance_items.map { |item|
        {
          id: item.id,
          item_date: item.item_date&.strftime("%Y-%m-%d"),
          item_maintenance_details: item.item_maintenance_details,
          item_reson_implementation: item.item_reson_implementation,
          item_location: item.item_location,
          item_organizer: item.item_organizer,
          item_note: item.item_note
        }
      }.to_json %>;

      let rowCount = 0;

      function addItem(data) {
        const tbody = document.getElementById('inspection_items_body');
        const newIndex = rowCount;
        const rowNum = rowCount + 1;

        if (rowNum > 10) {
          alert('最大10行まで追加できます');
          return;
        }

        const id = data ? data.id : '';
        const itemDate = data ? data.item_date : '';
        const details = data ? data.item_maintenance_details : '';
        const reason = data ? data.item_reson_implementation : '';
        const location = data ? data.item_location : '';
        const organizer = data ? data.item_organizer : '';
        const note = data ? data.item_note : '';

        const newRow = `
          <tr>
            <td>
              <input type="hidden" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][id]" value="${id}">
              <input class="form-control text-center border border-secondary" type="date" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][item_date]" value="${itemDate}" style="height: 31px; display: inline-block;">
            </td>
            <td></td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="整備の内容" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][item_maintenance_details]" value="${details}" style="width: 100%; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="実施理由" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][item_reson_implementation]" value="${reason}" style="width: 100%; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="住所" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][item_location]" value="${location}" style="width: 100%; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="名前" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][item_organizer]" value="${organizer}" style="width: 100%; display: inline-block;">
            </td>
            <td style="text-align: center;">
              <input class="form-control form-control-sm text-left border border-secondary" type="text" placeholder="備考" name="inspection_maintenance[inspection_maintenance_items_attributes][${newIndex}][item_note]" value="${note}" style="width: 100%; display: inline-block;">
            </td>
          </tr>`;

        tbody.insertAdjacentHTML('beforeend', newRow);
        rowCount++;
      }

      function removeItem() {
        const tbody = document.getElementById('inspection_items_body');
        const rows = tbody.querySelectorAll('tr');
        if (rows.length <= 1) {
          alert('最低1行は必要です');
          return;
        }
        tbody.removeChild(rows[rows.length - 1]);
        rowCount--;
      }

      // 既存データを初期表示
      if (existingItems.length > 0) {
        existingItems.forEach(function(item) {
          addItem(item);
        });
      } else {
        addItem(null);
      }

      document.getElementById('add_item_btn').addEventListener('click', function() {
        addItem(null);
      });
      document.getElementById('remove_item_btn').addEventListener('click', removeItem);
    })();
    </script>

  </div>
</turbo-frame>
