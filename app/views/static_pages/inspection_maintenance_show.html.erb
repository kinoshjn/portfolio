<turbo-frame id="main_content"> 
  <div class="wrapper">

    <div class="box1 overflow-x-auto">
      <%= render 'shared/side_menu' %> 
    </div>

    <div class="box2 overflow-x-auto">
    <!-- box2貼り付け部 -->
        <ul class="main-nav font-english">
          <li><span class="fs-3" style="margin-right: 10px;">点検装備詳細</span></li>
          <li><span class="fs-4" style="margin-right: 20px;">点検装備ID: <%= @inspection_maintenance.id %> </span></li>
          <li>
            <%= button_to "編集", inspection_maintenance_edit_path, method: :get,
              class: "btn btn-success btn-sm ms-3",
              form: { class: "d-inline", data: { turbo_frame: "main_content" } } %>
          </li>

          <li>
            <button type="button" class="btn btn-danger btn-sm ms-3"
              onclick="window.open('<%= delete_confirm_index_path(id: @inspection_maintenance.id, type: :inspection_maintenance) %>', '_blank', 'width=600,height=500,scrollbars=yes,resizable=yes')">削除
            </button>
          </li>
        </ul>
    </div>

    <div class="box3 overflow-x-auto box3--plain">
    <!-- box3貼り付け部 -->

    <!--    テーブル幅を固定にして幅を有効にする。
      <table class="table table-bordered table-sm text-center" >
     -->

      <table class="table table-bordered table-sm text-center" style="table-layout: fixed; width: 1220px;">

        <thead>
          <tr class="text-center">
            <th scope="col"; style="width: 110px; height: auto;" >実施日</th>
            <th scope="col"; style="width: 120px; height: auto;">総飛行時間</th>
            <th scope="col"; style="height: auto;">点検、修理、改造及び整備の内容</th>
            <th scope="col"; style="width: 260px; height: auto;">実施理由</th>
            <th scope="col"; style="width: 240px; height: auto;">実施場所</th>
            <th scope="col"; style="width: 90px; height: auto;">実施者</th>
            <th scope="col"; style="width: 160px; height: auto;">備考</th>
          </tr>
        </thead>

        <!-- 点検装備詳細 2026.6/28 dbデータ表示 -->

        <% @inspection_maintenance.inspection_maintenance_items.each do |inspection_maintenance_item| %>

          <tbody class="table-group-divider text-left">
            <tr>
              <td> <%= inspection_maintenance_item.item_date %>                 </td>
              <td> <%= inspection_maintenance_item.item_total_flight_time %>分  </td>
              <td> <%= inspection_maintenance_item.item_maintenance_details %>  </td>
              <td> <%= inspection_maintenance_item.item_reson_implementation %> </td>
              <td> <%= inspection_maintenance_item.item_location %>             </td>
              <td> <%= inspection_maintenance_item.item_organizer %>            </td>
              <td> <%= inspection_maintenance_item.item_note %>                 </td>
            </tr>
          </tbody>
        <% end %>

    </table>


      <table class="table table-bordered table-sm text-center" style="table-layout: fixed; width: 730px;">
        <thead>
          <tr class="text-center">
            <th scope="col"; style="width: 200px; height: auto;" >項目</th>
            <th scope="col"; style="height: auto;">内容</th>
          </tr>
        </thead>

        <tbody class="table-group-divider text-start">
          <tr>
            <th scope="row">飛行機体</th>
            <td>  <%= @inspection_maintenance.aircraft.model_purchased %>  </td>
          </tr>
          <tr>
            <th scope="row">無人飛行機の登録番号</th>
            <td>  <%= @inspection_maintenance.aircraft.dips_registration_number %>  </td>
          </tr>
          <tr>
            <th scope="row">特記事項</th>
            <td>  <%= @inspection_maintenance.special_notes %>  </td>
          </tr>
        </tbody>
      </table>

    </div>
  </div>
</turbo-frame>