  <main class="form-signin">

  <% flash.each do |message_type, message| %>
    <div class="alert alert-<%= message_type %>">
      <%= message %>
    </div>
  <% end %>


    <%= form_with model: @user do |f| %>

      <h3 class="h3 mb-3 fw-normal text-center">ユーザ登録</h3>

      <div class="form-floating mb-3">
        <%= f.text_field :user_name, class: "form-control #{'is-invalid' if @user.errors[:user_name].any?}",
        placeholder: "例:山田太郎", id: "floatingName" %>
        <label for="floatingName">名前</label>
      </div>

      <div class="form-floating mb-3">
        <%= f.email_field :email, class: "form-control #{'is-invalid' if @user.errors[:email].any?}",
        placeholder: "name@example.com", id: "floatingEmail" %>
        <label for="floatingEmail">メールアドレス (user@example.com)</label>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password, class: "form-control #{'is-invalid' if @user.errors[:password].any?}",
        placeholder: "Password", id: "floatingPassword" %>
        <label for="floatingPassword">パスワード</label>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password_confirmation, class: "form-control #{'is-invalid' if @user.errors[:password_confirmation].any?}",
        placeholder: "Password", id: "floatingPassword_confirmation" %>
        <label for="floatingPassword_confirmation">パスワード確認</label>
      </div>

      <%= f.submit "登録", class: "mb-3 w-100 btn btn-lg btn-primary" %>
      <%= link_to "前の画面に戻る", login_path %>

      <p class="text-credit text-center">&copy; 2026 kino project</p>
    <% end %>
  </main>